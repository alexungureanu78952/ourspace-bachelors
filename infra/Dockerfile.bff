FROM node:24-alpine AS node-build
WORKDIR /src
COPY package*.json tsconfig.json ./
RUN npm ci --ignore-scripts
COPY runtime/ ./runtime/
RUN node_modules/.bin/tsc && node .build/runtime/profile-v1/build.js

FROM node:24-alpine AS frontend-build
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,id=ourspace-nuget-locked,sharing=locked,target=/root/.nuget/packages dotnet restore "services/bff/src/OurSpace.Bff.Api/OurSpace.Bff.Api.csproj" --locked-mode
RUN --mount=type=cache,id=ourspace-nuget-locked,sharing=locked,target=/root/.nuget/packages dotnet publish "services/bff/src/OurSpace.Bff.Api/OurSpace.Bff.Api.csproj" --no-restore -c Release -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0.13@sha256:d5633778c754e89a386882eddf8dbee6942447a8a4b8267c19cf1e1158d0b0ac
WORKDIR /app
RUN mkdir -p /var/ourspace/keys && chown app:app /var/ourspace/keys
COPY --from=build /out .
COPY --from=node-build /src/runtime/profile-v1/artifacts/ ./profile-runtime-artifacts/
COPY --from=frontend-build /src/frontend/out/ ./wwwroot/
ENV ASPNETCORE_HTTP_PORTS=8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    SSL_CERT_FILE=/run/secrets/ca.crt
USER app
EXPOSE 8080
